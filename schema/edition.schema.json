{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newsgpt.local/schema/edition.schema.json",
  "title": "NewsGPT Edition",
  "description": "A frozen, normalized newspaper edition. Produced by build.js from raw Hermes drops; consumed by web/.",
  "type": "object",
  "additionalProperties": false,
  "required": ["edition_date", "generated_at", "sections"],
  "properties": {
    "edition_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string", "description": "ISO 8601 UTC timestamp of the build." },
    "sample": {
      "type": "boolean",
      "description": "True if any contributing drop was flagged synthetic. Surfaced in the masthead."
    },
    "run_ids": { "type": "array", "items": { "type": "string" } },
    "lead_story_id": {
      "type": ["string", "null"],
      "description": "Story rendered as the page-wide front-page lead; filtered out of its column."
    },
    "story_count": { "type": "integer", "minimum": 0 },
    "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "stories"],
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "enum": ["sector", "ticker", "macro"],
          "description": "'ticker' sections are promoted by the builder when one symbol dominates."
        },
        "title": { "type": "string" },
        "tickers": { "type": "array", "items": { "type": "string" } },
        "lede": { "type": ["string", "null"] },
        "sentiment": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
        "stories": { "type": "array", "items": { "$ref": "#/$defs/story" } }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "headline", "importance", "sources"],
      "properties": {
        "id": { "type": "string" },
        "event_key": {
          "type": ["string", "null"],
          "description": "Hermes-assigned event identity; authoritative for deduplication."
        },
        "headline": { "type": "string", "minLength": 1 },
        "dek": { "type": ["string", "null"] },
        "body_md": { "type": ["string", "null"] },
        "tickers": { "type": "array", "items": { "type": "string" } },
        "sector": { "type": "string" },
        "importance": { "type": "integer", "minimum": 1, "maximum": 5 },
        "sentiment": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
        "merged_count": {
          "type": "integer",
          "minimum": 1,
          "description": "How many near-duplicate scraped stories collapsed into this one."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "title": { "type": ["string", "null"] },
        "url": { "type": "string", "pattern": "^https?://" },
        "publisher": { "type": ["string", "null"] },
        "published_at": { "type": ["string", "null"] }
      }
    }
  }
}
